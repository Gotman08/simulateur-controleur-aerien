# =============================================================================
# Configuration des fournisseurs IA (contrat OpenAI-compatible)
# =============================================================================
# Copiez ce fichier en `.env` a la racine du projet puis remplissez UNE des
# configurations ci-dessous. Changer de modele/fournisseur = changer URL + cle
# + nom de modele, rien d'autre.
#
# Contrat attendu par l'application (standard OpenAI) :
#   STT : POST {ATC_STT_URL}/v1/audio/transcriptions   (multipart file+model)
#   LLM : POST {ATC_LLM_URL}/v1/chat/completions       (messages JSON)
#   TTS : POST {ATC_TTS_URL}/v1/audio/speech           ({model,input,voice,response_format})
#   Sante : GET {URL}/v1/models
# Les URLs sont acceptees avec ou sans le suffixe /v1.
# Une cle vide = pas d'en-tete Authorization (serveurs auto-heberges).

# ============ Config A : facade auto-hebergee (server.py sur ROMEO via tunnel SSH) ============
# (lancer start_romeo.ps1 pour soumettre le job + ouvrir le tunnel 8765/8766)
ATC_STT_URL=http://localhost:8765
ATC_STT_KEY=
ATC_STT_MODEL=whisper-atc-lora
ATC_LLM_URL=http://localhost:8765
ATC_LLM_KEY=
ATC_LLM_MODEL=mistral-7b-atc
ATC_TTS_URL=http://localhost:8766
ATC_TTS_KEY=
ATC_TTS_MODEL=xtts-atc
# Pool de voix : hachage deterministe du callsign -> meme avion = meme voix.
ATC_TTS_VOICES=pilot_1,pilot_2,pilot_3
# Degradation radio VHF 300-3400 Hz appliquee COTE CLIENT (provider-agnostique).
ATC_TTS_VHF=1
# Requis =wav si ATC_TTS_VHF=1 (le DSP ne decode que du WAV).
ATC_TTS_FORMAT=wav

# ============ Config B : OpenAI cloud (les 3 briques) ============
# ATC_STT_URL=https://api.openai.com
# ATC_STT_KEY=sk-...
# ATC_STT_MODEL=whisper-1
# ATC_LLM_URL=https://api.openai.com
# ATC_LLM_KEY=sk-...
# ATC_LLM_MODEL=gpt-4o-mini
# ATC_TTS_URL=https://api.openai.com
# ATC_TTS_KEY=sk-...
# ATC_TTS_MODEL=gpt-4o-mini-tts
# ATC_TTS_VOICES=alloy,echo,onyx,shimmer
# ATC_TTS_VHF=1
# ATC_TTS_FORMAT=wav

# ============ Config C : mix multi-fournisseurs ============
# STT Groq (compatible OpenAI) :
#   ATC_STT_URL=https://api.groq.com/openai
#   ATC_STT_KEY=gsk_...
#   ATC_STT_MODEL=whisper-large-v3
# LLM Mistral API :
#   ATC_LLM_URL=https://api.mistral.ai
#   ATC_LLM_KEY=...
#   ATC_LLM_MODEL=mistral-small-latest
# TTS serveur compatible (openedai-speech, kokoro-fastapi, passerelle ElevenLabs...) :
#   ATC_TTS_URL=http://localhost:8880
#   ATC_TTS_KEY=
#   ATC_TTS_MODEL=kokoro
#   ATC_TTS_VOICES=af_bella,am_adam,af_sky
